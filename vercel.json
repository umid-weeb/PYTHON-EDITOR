{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/arena",
      "destination": "/zone",
      "permanent": true
    },
    {
      "source": "/arena/(.*)",
      "destination": "/zone/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://16.16.26.138/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "http://16.16.26.138/uploads/$1"
    },
    {
      "source": "/zone/(.*)",
      "destination": "/zone/index.html"
    },
    {
      "source": "/zone",
      "destination": "/zone/index.html"
    }
  ]
}
